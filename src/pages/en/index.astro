---
import MinimalMarketingLayout from "#www/layouts/MinimalMarketingLayout.astro"
import { Navbar } from "#www/components/Navbar"
import { Hero } from "#www/components/Hero"
import { ContentWithTestimonial } from "#www/components/ContentWithTestimonial"
import { FeatureGridOffset } from "#www/components/FeatureGridOffset"
import { FeaturesWithProductScreenshot } from "#www/components/FeaturesWithProductScreenshot"
import { Testimonials } from "#www/components/Testimonials"
import { FeatureGridCentered } from "#www/components/FeatureGridCentered"
import { Pricing } from "#www/components/Pricing"
import { FAQ } from "#www/components/FAQ"
import { CTA } from "#www/components/CTA"
import { Footer } from "#www/components/Footer"
---

<MinimalMarketingLayout
	title="Hasiber - Your Personal Spiritual Journal"
	description="Track your daily acts of worship and grow in consistency. Bring yourself to account before you are brought to account."
>
	<Navbar
		locale="en"
		client:load
		logo={{
			text: "Hasiber",
			href: "/en/",
		}}
		navigation={[
			{ name: "Features", href: "#features" },
			{ name: "Experience", href: "#experience" },
			{ name: "FAQ", href: "#faq" },
			{ name: "Blog", href: "/en/blog" },
		]}
		cta={{
			text: "Go to App",
			href: "/app",
		}}
		languages={[
			{ name: "English", href: "/en/" },
			{ name: "العربية", href: "/ar/" },
		]}
	/>

	<div class="pt-3 pb-12 md:pb-24">
		<Hero
			client:load
			badge={{
				text: "Spiritual Growth Made Simple",
				href: "#features",
				description: "Track your Ibaadah with ease",
			}}
			title="Bring yourself to account before you are brought to account"
			description="Hasiber helps you consistently perform your daily acts of worship. Track Salah, Quran, Dhikr, and more with gentle motivation and meaningful reflection."
			primaryCta={{
				text: "Start Your Journey",
				href: "/app",
			}}
			secondaryCta={{
				text: "Learn more",
				href: "#features",
			}}
			media={{
				kind: "image",
				src: "/images/screenshots/en-people.webp",
				alt: "Phone showing Hasiber dashboard",
				loading: "eager",
				aspectRatio: "215 / 466",
				fit: "contain",
			}}
		/>
	</div>
	<div id="story" class="py-24">
		<ContentWithTestimonial
			title="The Challenge We Face"
			testimonial={{
				quote: "Most Muslims increase in religion during Ramadan, then decrease after Ramadan.",
				author: {
					name: "Spiritual Growth",
					title: "A common struggle",
					avatar: "/images/avatars/carl.webp",
				},
			}}
		>
			<p>
				Consistency in acts of worship is one of the greatest challenges for
				Muslims. We start strong, but life gets busy and our spiritual practices
				slip away.
			</p>
			<p>
				<b
					>Hasiber helps you maintain consistency with gentle tracking, daily
					motivation, and meaningful reflection.</b
				>
			</p>
		</ContentWithTestimonial>
	</div>
	<div class="py-12 md:py-24">
		<FeatureGridOffset
			title="Challenges Hasiber Helps You Overcome"
			subtitle="Real problems in your spiritual journey"
			problems={[
				{
					name: "Losing consistency after Ramadan",
					description:
						"Maintain your spiritual momentum throughout the year, not just during blessed months",
				},
				{
					name: "Forgetting daily prayers",
					description:
						"Track your Salah completion and build the habit of praying on time",
				},
				{
					name: "Irregular Quran reading",
					description:
						"Set daily goals and track your progress to make Quran a consistent part of your day",
				},
				{
					name: "Lack of spiritual reflection",
					description:
						"Take time to reflect on your spiritual state and grow in self-awareness",
				},
			]}
		/>
	</div>

	<div class="py-12 md:py-24">
		<FeaturesWithProductScreenshot
			badge="How it works"
			title="Simple. Gentle. Encouraging."
			features={[
				{
					name: "Track your Ibaadah",
					description:
						"Log your daily prayers, Quran reading, Dhikr, and other acts of worship with ease.",
				},
				{
					name: "See your progress",
					description:
						"Visual dashboard shows your consistency, streaks, and areas for improvement.",
				},
				{
					name: "Receive gentle motivation",
					description:
						"Personalized verses and hadith based on your progress, encouraging you without judgment.",
				},
			]}
			media={{
				kind: "image",
				src: "/images/screenshots/en-person.webp",
				alt: "Phone showing Hasiber dashboard",
				aspectRatio: "215 / 466",
				fit: "contain",
			}}
		/>
	</div>
	<div class="py-24" id="features">
		<FeatureGridCentered
			title="Everything You Need for Spiritual Growth"
			description="A complete toolkit for tracking, reflecting, and growing in your faith."
			features={[
				{
					name: "Daily Ibaadah Tracking",
					description:
						"Track Salah, Quran, Dhikr, Sadaqa, Fasting, and custom spiritual habits all in one place",
					icon: "PersonHearts",
				},
				{
					name: "Spiritual Reflection",
					description:
						"Private notes to reflect on your daily spiritual state and track your growth over time",
					icon: "Bell",
				},
				{
					name: "AI-Powered Motivation",
					description:
						"Personalized daily verses and hadith based on your progress, with gentle encouragement when you need it",
					icon: "PhoneFill",
				},
				{
					name: "Group & Family Tracking",
					description:
						"Create groups with family or friends to encourage accountability and healthy spiritual competition",
					icon: "Chat",
				},
				{
					name: "Points & Rewards",
					description:
						"Earn points for consistency and unlock rewards. Gamify your spiritual journey in a meaningful way.",
					icon: "Download",
				},
				{
					name: "Complete Privacy",
					description:
						"Your data is encrypted and private. Export anytime. Full control over your spiritual journal.",
					icon: "CloudCheck",
				},
			]}
		/>
	</div>

	<div class="py-12 md:py-24">
		<Testimonials
			client:load
			title="What Users Say"
			subtitle="Muslims finding consistency in their spiritual journey"
			testimonials={[
				{
					quote:
						"Hasiber helped me maintain my Salah consistency even after Ramadan. The gentle reminders and progress tracking keep me motivated.",
				},
				{
					quote:
						"I love the daily verses feature. It's like having a personal spiritual guide that knows exactly what I need to hear.",
				},
				{
					quote:
						"The reflection feature has been transformative. Taking time each day to reflect on my spiritual state has deepened my connection with Allah.",
				},
				{
					quote:
						"Tracking with my family has created healthy competition and accountability. We're all growing together.",
				},
			]}
		/>
	</div>
	<div class="py-12 md:py-24">
		<FeaturesWithProductScreenshot
			client:load
			badge="AI Motivation Engine"
			title="Personalized spiritual guidance based on your journey."
			features={[
				{
					name: "Daily Verses & Hadith:",
					description:
						"Receive personalized verses or hadith each day based on your progress and spiritual state.",
				},
				{
					name: "Gentle Encouragement:",
					description:
						"When you're consistent, celebrate with you. When you fall behind, gentle reminders without judgment.",
				},
				{
					name: "Spiritual Insights:",
					description:
						"AI analyzes your patterns and provides meaningful insights to guide your focus and growth.",
				},
				{
					name: "Reflection Prompts:",
					description:
						"Thoughtful questions to deepen your self-reflection and spiritual awareness.",
				},
			]}
			closing="A companion that understands your journey and supports you every step of the way."
			media={{
				kind: "image",
				src: "/images/screenshots/en-chat.webp",
				alt: "Phone showing Hasiber AI motivation",
				aspectRatio: "215 / 466",
				fit: "contain",
			}}
		/>
	</div>
	<div id="experience" class="py-24">
		<Pricing
			title="Choose Your Experience"
			subtitle="Free or Pro - simple pricing for everyone."
			tiers={[
				{
					name: "Free",
					id: "tier-free",
					href: "/app",
					priceMonthly: "Free",
					priceSuffix: null,
					description:
						"Free requires a sign in for sync and push notifications",
					features: [
						"Track all Ibaadah types",
						"Daily progress dashboard",
						"Spiritual reflection notes",
						"Push notifications",
						"Sync across devices",
						"Export your data",
					],
					featured: false,
					ctaText: "Sign Up Free",
				},
				{
					name: "Pro",
					id: "tier-plus",
					href: "/app",
					priceMonthly: "$6",
					priceSuffix: "/month",
					description:
						"AI motivation engine and group features - 30-day free trial",
					features: [
						"Everything in Free",
						"AI-powered daily verses & hadith",
						"Personalized motivation engine",
						"Group & family tracking",
						"Advanced analytics & insights",
						"Points & rewards system",
						"Support sustainable development",
					],
					featured: true,
					ctaText: "Upgrade to Pro",
				},
			]}
		/>
	</div>

	<div id="faq" class="py-24">
		<FAQ
			client:load
			title="Frequently Asked Questions"
			faqs={[
				{
					question: "How is this different from other habit trackers?",
					answer:
						"Hasiber is specifically designed for spiritual growth. It understands the unique needs of Muslims tracking acts of worship, provides Islamic context through verses and hadith, and creates a non-judgmental space for reflection and growth.",
				},
				{
					question: "Will Hasiber work offline?",
					answer:
						"Yes! All tracking features work offline. Your data syncs when you're back online. Only the AI motivation features require an internet connection.",
				},
				{
					question: "What if I miss a day or fall behind?",
					answer:
						"Hasiber is designed to be gentle and encouraging, not judgmental. Pick up where you left off. The app provides motivation and support, never guilt or pressure.",
				},
				{
					question: "Is my spiritual data private?",
					answer:
						"Absolutely. Your data is encrypted in the browser before syncing. Only you have access to your reflections and tracking. You can export your data anytime. Complete privacy and control.",
				},
				{
					question: "Can I track with my family?",
					answer:
						"Yes! Hasiber Pro includes group and family tracking features. Create groups to encourage accountability and healthy spiritual competition with loved ones.",
				},
				{
					question: "Why pay for Pro when the free version exists?",
					answer:
						"The free version includes all core tracking features. Pro adds AI-powered motivation, group features, advanced analytics, and supports sustainable development. Try it free for 30 days!",
				},
			]}
		/>
	</div>

	<CTA
		title="Ready to grow in consistency?"
		primaryCta={{
			text: "Start Your Journey",
			href: "/app",
		}}
	/>

	<Footer
		navigation={{
			main: [
				{ name: "Features", href: "#features" },
				{ name: "Experience", href: "#experience" },
				{ name: "FAQ", href: "#faq" },
				{ name: "Blog", href: "/en/blog" },
				{ name: "Imprint", href: "/en/imprint" },
				{ name: "Privacy", href: "/en/privacy" },
			],
			social: [
				{
					name: "Twitter",
					href: "https://twitter.com/tillydotsocial",
					icon: "Twitter",
				},
				{
					name: "Instagram",
					href: "https://instagram.com/tilly.social",
					icon: "Instagram",
				},
				{
					name: "GitHub",
					href: "https://github.com/ccssmnn/tilly",
					icon: "Github",
				},
			],
			languages: [
				{ name: "English", href: "/en/" },
				{ name: "العربية", href: "/ar/" },
			],
		}}
		company={{
			name: "Hasiber",
		}}
	/>
</MinimalMarketingLayout>
